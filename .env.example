# ===========================================
# KLINCHAPP ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER commit real secrets to the repo.
#
# Keep a backup of every secret value in a password manager. GitHub Actions
# secrets and most provider dashboards do NOT let you read a secret back after
# creation — a lost local copy means rotating the credential.

# ─── Core app — required for `npm run dev` ──────────────────────────
# Supabase: dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key

# App URL — http://localhost:3000 for local dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Blog pipeline — required to run scripts/blog-pipeline.mjs ───────
# AI failover providers (used when Anthropic is unavailable)
OPENAI_API_KEY=sk-your-openai-key
GOOGLE_AI_API_KEY=your-google-ai-key

# Resend: resend.com → API Keys. Powers blog + syndication-failure emails.
RESEND_API_KEY=re_your-resend-key

# ─── Blogger syndication — scripts/syndicate-to-blogger.mjs ──────────
# Full setup walkthrough: scripts/BLOGGER_API_SETUP.md
# CLIENT_ID and BLOG_ID are not secret; CLIENT_SECRET and REFRESH_TOKEN are.
BLOGGER_CLIENT_ID=your-client-id.apps.googleusercontent.com
BLOGGER_CLIENT_SECRET=GOCSPX-your-secret
BLOGGER_REFRESH_TOKEN=1//your-refresh-token
BLOGGER_BLOG_ID=your-numeric-blog-id

# ─── WordPress syndication — scripts/syndicate-to-wordpress.mjs ──────
WORDPRESS_ACCESS_TOKEN=your-wordpress-access-token
WORDPRESS_SITE_ID=your-site-id-or-domain

# ─── CI only — set as GitHub Actions secrets, not needed in .env.local ──
# PAT_TOKEN ................. fine-grained GitHub PAT; lets workflows push
# Vercel protection-bypass .. used by the homepage-check workflow
